{
    "name": "Mainsail Proxy",
    "version": "0.2.0",
    "slug": "mainsail_proxy",
    "description": "Proxy for externally running Miansail",
    "url": "https://github.com/Ericsson2506/addon-test",
    "arch": [
      "aarch64",
      "amd64",
      "armhf",
      "armv7",
      "i386"
    ],
    "boot": "auto",
    "init": true,
    "true": true,
    "ingress": true,
    "timeout": 30,
    "panel_icon": "mdi:printer-3d",
    "map": [
      "config:ro"
    ],
    "ports": {
      "80/tcp": null
    },
    "ports_description": {
      "80/tcp": "Frontend tcp-listen port"
    },
    "options": {
      "server": null,
      "auth_token": ""
    },
    "schema": {
      "server": "url",
      "auth_token": "str?"
    },
    "image": "zigbee2mqtt/zigbee2mqtt-proxy-{arch}"
}
